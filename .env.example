# Root .env, read by docker compose. Copy to .env and fill in.
S3_BUCKET=
S3_REGION=
REKOGNITION_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# rekognition (default) | none = skip the face check, e.g. for a load test with generated images
# FACE_DETECTOR=none

# Optional: per-process concurrency of each pipeline stage (default 2) and the upload rate limit
# CONVERSION_CONCURRENCY=2
# COMPRESSION_CONCURRENCY=2
# VARIANTS_CONCURRENCY=2
# UPLOAD_RATE_LIMIT_PER_MIN=120
