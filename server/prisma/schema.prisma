generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Lifecycle: PENDING (stored, queued) -> PROCESSING (worker picked it up)
///            -> ACCEPTED | REJECTED (validation outcome, terminal)
///            -> FAILED (infrastructure error after all retries, terminal)
enum ImageStatus {
  PENDING
  PROCESSING
  ACCEPTED
  REJECTED
  FAILED
}

/// Machine-readable rejection reason. The UI maps these to copy; analytics can GROUP BY them.
enum RejectionCode {
  FILE_TOO_SMALL
  FILE_TOO_LARGE
  UNSUPPORTED_FORMAT
  CORRUPT_IMAGE
  RESOLUTION_TOO_LOW
  BLURRY
  DUPLICATE
  NO_FACE
  MULTIPLE_FACES
  FACE_TOO_SMALL
}

model Image {
  id                String         @id @default(uuid()) @db.Uuid
  /// The set of photos a user uploads together (stand-in for userId until auth exists).
  /// Duplicate detection is scoped to a collection: two different users can upload similar photos.
  collectionId      String         @map("collection_id") @db.Uuid
  originalFilename  String         @map("original_filename") @db.VarChar(255)
  /// MIME type detected from the file's magic bytes, never the client-supplied header.
  detectedMimeType  String?        @map("detected_mime_type") @db.VarChar(32)
  sizeBytes         Int            @map("size_bytes")
  status            ImageStatus    @default(PENDING)
  rejectionCode     RejectionCode? @map("rejection_code")
  rejectionReason   String?        @map("rejection_reason")
  /// Last infrastructure error (S3/Rekognition outage). Only set for FAILED.
  errorMessage      String?        @map("error_message")

  // S3 object keys (bucket is private; URLs are presigned at read time)
  originalKey       String?        @map("original_key")
  processedKey      String?        @map("processed_key")
  thumbnailKey      String?        @map("thumbnail_key")
  processedMimeType String?        @map("processed_mime_type") @db.VarChar(32)

  // Validation metrics, stored so thresholds can be tuned against real data later
  width             Int?
  height            Int?
  blurScore         Float?         @map("blur_score")
  faceCount         Int?           @map("face_count")
  faceAreaRatio     Float?         @map("face_area_ratio")
  /// SHA-256 of the uploaded file bytes -> exact duplicate detection (re-encodes are caught by perceptualHash)
  contentHash       String?        @map("content_hash") @db.Char(64)
  /// 64-bit difference hash -> near-duplicate detection via Hamming distance
  perceptualHash    BigInt?        @map("perceptual_hash")

  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  processedAt       DateTime?      @map("processed_at")

  processingJob     ProcessingJob?
  variants          ImageVariant[]

  // Keyset pagination: WHERE collection_id = ? [AND status = ?] ORDER BY created_at DESC, id DESC
  @@index([collectionId, status, createdAt(sort: Desc), id(sort: Desc)])
  @@index([collectionId, createdAt(sort: Desc), id(sort: Desc)])
  // Reconciler: find PENDING rows whose job may have been lost
  @@index([status, createdAt])
  // NOTE: partial unique index (collection_id, content_hash) WHERE status = 'ACCEPTED' is added
  // in the migration SQL (Prisma can't express partial indexes). It makes "two identical
  // accepted images in one collection" impossible at the database level.
  @@map("images")
}

/// Media pipeline (Part 2), entered automatically once an image is ACCEPTED.
/// status = the stage the job is currently in (waiting or running):
///   QUEUED -> CONVERTING -> COMPRESSING -> GENERATING_VARIANTS -> COMPLETED
///   any stage -> FAILED (failed_stage + error_message say where and why)
enum PipelineStatus {
  QUEUED
  CONVERTING
  COMPRESSING
  GENERATING_VARIANTS
  COMPLETED
  FAILED
}

enum PipelineStage {
  CONVERSION
  COMPRESSION
  VARIANTS
}

enum VariantKind {
  THUMBNAIL
  WEB
  FULL
}

/// One row per image. A reprocess resets it and increments `run`; queue messages carry the run
/// they belong to, so messages from an older run are recognised and skipped.
model ProcessingJob {
  imageId          String          @id @map("image_id") @db.Uuid
  status           PipelineStatus  @default(QUEUED)
  run              Int             @default(1)
  failedStage      PipelineStage?  @map("failed_stage")
  errorMessage     String?         @map("error_message")

  // Intermediate artifacts (deterministic S3 keys, overwritten on reprocess)
  convertedKey     String?         @map("converted_key")
  convertedBytes   Int?            @map("converted_bytes")
  compressedKey    String?         @map("compressed_key")
  compressedBytes  Int?            @map("compressed_bytes")
  /// converted_bytes / compressed_bytes (2.5 = output is 2.5x smaller than the compression input)
  compressionRatio Float?          @map("compression_ratio")
  width            Int?
  height           Int?

  // Per-stage timestamps: status page + load-test latency breakdown
  queuedAt         DateTime        @default(now()) @map("queued_at")
  convertedAt      DateTime?       @map("converted_at")
  compressedAt     DateTime?       @map("compressed_at")
  completedAt      DateTime?       @map("completed_at")
  failedAt         DateTime?       @map("failed_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  image Image @relation(fields: [imageId], references: [id], onDelete: Cascade)

  // Reconciler (stuck jobs) and stats
  @@index([status, updatedAt])
  @@map("processing_jobs")
}

/// Composite primary key (image_id, kind): a duplicate variant is impossible at the DB level,
/// and reprocessing upserts in place.
model ImageVariant {
  imageId   String      @map("image_id") @db.Uuid
  kind      VariantKind
  key       String
  /// Canonical S3 object URL (bucket is private: the API serves a presigned URL for it).
  /// Behind a CDN this would be the CDN URL.
  url       String
  mimeType  String      @map("mime_type") @db.VarChar(32)
  width     Int
  height    Int
  sizeBytes Int         @map("size_bytes")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  image Image @relation(fields: [imageId], references: [id], onDelete: Cascade)

  @@id([imageId, kind])
  @@map("image_variants")
}
