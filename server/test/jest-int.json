{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testRegex": ".int-spec.ts$",
  "transform": { "^.+\\.(t|j)s$": "ts-jest" },
  "testEnvironment": "node",
  "globalSetup": "<rootDir>/int-global-setup.ts",
  "setupFiles": [
    "<rootDir>/../src/load-env.ts",
    "<rootDir>/use-test-db.ts",
    "<rootDir>/../src/test-utils/silence-logs.ts"
  ]
}
