# Copy to .env. Postgres/Redis values match docker-compose.yml; fill in the AWS section.

# api = HTTP only | worker = validation consumer | conversion / compression / variants = one
# media-pipeline stage each | all = everything in one process (local dev)
PROCESS_ROLE=all
PORT=3001
CORS_ORIGINS=http://localhost:3000

DATABASE_URL=postgresql://app:app@localhost:5433/images?schema=public
REDIS_URL=redis://localhost:6380

# AWS: a private S3 bucket for storage and Rekognition for face detection.
# The IAM user needs s3:PutObject/GetObject/DeleteObject on the bucket's objects,
# s3:ListBucket on the bucket (health check) and rekognition:DetectFaces.
S3_BUCKET=
S3_REGION=
# Accounts created with AWS's newer sign-up ("free plan") only allow most services in the
# region chosen at sign-up; elsewhere calls fail with "explicit deny in a service control policy".
REKOGNITION_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Worker (applies to whichever consumer(s) this process runs)
WORKER_CONCURRENCY=4
JOB_ATTEMPTS=3

# Media pipeline (defaults shown)
# COMPRESSION_QUALITY=80
# THUMBNAIL_MAX_PX=256
# WEB_MAX_PX=1280
# Uploads per minute per IP; raise for the load test
# UPLOAD_RATE_LIMIT_PER_MIN=120

# Validation thresholds (defaults shown)
# MIN_FILE_BYTES=10240
# MAX_FILE_BYTES=20971520
# MIN_DIMENSION_PX=512
# BLUR_THRESHOLD=40
# SIMILARITY_MAX_HAMMING=6
# MIN_FACE_CONFIDENCE=90
# MIN_FACE_AREA_RATIO=0.04
# MIN_FACE_SIZE_PX=100
