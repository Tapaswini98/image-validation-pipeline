# Copy to .env. Values below match docker-compose.yml, so only the AWS keys need filling in.

# api = HTTP only | worker = queue consumer only | all = both (local dev)
PROCESS_ROLE=all
PORT=3001
CORS_ORIGINS=http://localhost:3000

DATABASE_URL=postgresql://app:app@localhost:5433/images?schema=public
REDIS_URL=redis://localhost:6380

# Storage: S3Mock locally (docker-compose). For real S3, remove S3_ENDPOINT and the S3_* keys
# (the SDK then uses the AWS credential chain).
S3_BUCKET=images
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9090
S3_ACCESS_KEY_ID=local
S3_SECRET_ACCESS_KEY=local

# Face detection: AWS Rekognition (needs real AWS credentials with rekognition:DetectFaces).
# FACE_DETECTOR=stub runs everything else without AWS (pretends every image has one face). Dev only.
FACE_DETECTOR=rekognition
# Accounts created with AWS's newer sign-up ("free plan" / projects) only allow most services in the
# region chosen at sign-up; elsewhere calls fail with "explicit deny in a service control policy".
REKOGNITION_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Worker
WORKER_CONCURRENCY=4
JOB_ATTEMPTS=3

# Validation thresholds (defaults shown)
# MIN_FILE_BYTES=10240
# MAX_FILE_BYTES=20971520
# MIN_DIMENSION_PX=512
# BLUR_THRESHOLD=40
# SIMILARITY_MAX_HAMMING=6
# MIN_FACE_CONFIDENCE=90
# MIN_FACE_AREA_RATIO=0.04
# MIN_FACE_SIZE_PX=100
